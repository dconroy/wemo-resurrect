# Copy this file to `.env` in the repo root. Docker Compose reads `.env` for variable substitution
# when you run `docker compose up` (see README). For local `uvicorn` only, you can also use `.env`
# in the directory you start the server from.
#
# Host interface: 127.0.0.1 (default, local machine only) or 0.0.0.0 for all interfaces (LAN).
WEMO_DASHBOARD_HOST=127.0.0.1

# HTTP port for API + static UI
WEMO_DASHBOARD_PORT=8765

# When set to 1 or true, bind to 0.0.0.0 regardless of WEMO_DASHBOARD_HOST (convenience for Pi).
WEMO_DASHBOARD_BIND_LAN=0

# Optional shared secret. When set, all /api/* routes except GET /api/health require:
#   Authorization: Bearer <this value>
WEMO_ADMIN_PASSWORD=

# SQLite path (relative paths are resolved from the backend working directory)
WEMO_DATABASE_PATH=data/wemo_dashboard.db

# Log level: DEBUG, INFO, WARNING, ERROR
WEMO_LOG_LEVEL=INFO
